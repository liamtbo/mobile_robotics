include "include/pioneer.inc"
include "include/map.inc"
include "include/sick.inc"
include "include/box.inc"


resolution 0.05


speedup 1.000

window
(
    size [700 700]
    scale 33.562
    center [ -0.079 0.575 ]
    rotate [4.000 -212.000 ]

    show_data 1
)

floorplan
(
    name "office"
    size [ 16.000 16.000 16.000 ]
    pose [ 0.000 0.000 0.000 0.000 ]
    bitmap "bitmaps/office.png"
)

pioneer2dx_base_no_sonar
(
    name "robot"
    pose [ 0.000 0.000 0.000 0.000 ]
    sicklaser ( pose [ 0.000 0.000 0.000 0.000 ] )
    trail_length 400
)

